%% 内容は明らかなフィクション (TJD/THS のパロディ)。
%% 規模はノード 9 個・辺 8 本。
flowchart LR
    SUB["subject"] --> APP["apparatus body"]
    SEN["three sensors"] --> LOG["trial logger"]
    SIGH["exasperation mic"] --> SCO["sigh scorer"]
    SCO --> LOG
    APP --> SEN
    LOG --> COMB["combination rule"]
    COMB --> DISP["tremendous output display"]
    DISP --> ARCH["stored trial record"]
